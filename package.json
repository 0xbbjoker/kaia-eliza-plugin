{
  "name": "@elizaos/plugin-kaia",
  "version": "1.0.1",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "@elizaos/source": "./src/index.ts",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@elizaos/core": "latest",
    "@goat-sdk/adapter-vercel-ai": "0.2.10",
    "@goat-sdk/core": "0.5.0",
    "@goat-sdk/wallet-viem": "0.3.0",
    "@goat-sdk/wallet-evm": "0.3.0",
    "@kaiachain/kaia-agent-kit": "^0.0.15",
    "viem": "2.23.4"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "prettier --write ./src",
    "clean": "rm -rf dist .turbo node_modules .turbo-tsconfig.json tsconfig.tsbuildinfo",
    "format": "prettier --write ./src",
    "format:check": "prettier --check ./src",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "devDependencies": {
    "tsup": "8.3.5",
    "prettier": "^3.0.0",
    "bun": "^1.2.15",
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "KAIA_KAIASCAN_API_KEY": {
        "type": "string",
        "description": "Kaiascan API key",
        "required": false,
        "sensitive": true
      },
      "KAIA_EVM_PRIVATE_KEY": {
        "type": "string",
        "description": "EVM private key for wallet operations",
        "required": true,
        "sensitive": true
      },
      "KAIA_NETWORK": {
        "type": "string",
        "description": "Network selection (kaia for mainnet, kairos for testnet)",
        "required": false,
        "sensitive": false,
        "default": "kairos"
      },
      "KAIROS_FAUCET_AMOUNT": {
        "type": "string",
        "description": "Amount of KAIROS Test coins to transfer for user",
        "required": false,
        "sensitive": false,
        "default": "1"
      }
    }
  }
}
